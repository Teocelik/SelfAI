@using System.Security.Claims
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // F.M.Arch.1: Studio artık çok controller'lı (Hub + Image/Templates/Music/Video sekmeleri).
    // "Studio" nav item hangi sekmede olursa olsun aktif highlight alır.
    var isStudioActive = currentController == "StudioHub"
        || currentController == "ImageStudio"
        || currentController == "TemplatesStudio"
        || currentController == "MusicStudio"
        || currentController == "VideoStudio";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- ═══ CSS Dosyaları ═══ -->
    <link rel="stylesheet" href="~/css/main.css" />
    <link rel="stylesheet" href="~/css/toast.css" />
    <link rel="stylesheet" href="~/css/app-nav.css" />
    <link rel="stylesheet" href="~/css/lightbox.css" />
    <link rel="stylesheet" href="~/css/cookie-banner.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          rel="stylesheet" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="bg-background text-text-primary min-h-screen">

    <!-- ═══ Paylaşılan Üst Navigasyon (Liquid Glass) ═══ -->
    <nav class="app-nav">
        <div class="app-nav__container">
            <a href="/" class="app-nav__logo">
                SelfAI
            </a>

            <div class="app-nav__links" id="appNavLinks">
                <a asp-controller="StudioHub" asp-action="Index"
                   class="app-nav__link @(isStudioActive ? "app-nav__link--active" : "")">
                    <i class="fas fa-wand-magic-sparkles"></i>
                    <span>Studio</span>
                </a>
                <a asp-controller="Pricing" asp-action="Index"
                   class="app-nav__link @(currentController == "Pricing" ? "app-nav__link--active" : "")">
                    <i class="fas fa-tag"></i>
                    <span>Paketler</span>
                </a>
                <a asp-controller="History" asp-action="Index"
                   class="app-nav__link @(currentController == "History" ? "app-nav__link--active" : "")">
                    <i class="fas fa-clock-rotate-left"></i>
                    <span>Geçmiş</span>
                </a>
                @* F.6 yapılınca Characters buraya eklenir *@
            </div>

            <div class="app-nav__utilities">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* F.M.UI.2 — Bakiye pill artık ViewComponent'ten (tek kaynak, server-side değer). *@
                    @await Component.InvokeAsync("CreditBalance")

                    <div class="app-nav__user">
                        @(User.FindFirst(ClaimTypes.Name)?.Value
                          ?? User.FindFirst(ClaimTypes.Email)?.Value
                          ?? "Kullanıcı")
                    </div>

                    <form asp-controller="Account" asp-action="Logout" method="post" class="app-nav__logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="app-nav__logout" aria-label="Çıkış Yap">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="app-nav__login-cta">
                        Giriş Yap
                    </a>
                }
            </div>

            <button class="app-nav__hamburger" id="appNavHamburger" type="button" aria-label="Menü">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </nav>

    <main class="app-main">
        @RenderBody()
    </main>

    <!-- ═══ Toast Container (tüm app sayfalarında çalışır) ═══ -->
    <div id="toastContainer"></div>

    @* F.7.5 — Çerez onay banner'ı (tüm app sayfalarında) *@
    @await Html.PartialAsync("_CookieBanner")

    <!-- ═══ JavaScript Dosyaları ═══ -->
    <!-- SignalR Client (app.js generation bildirimleri için bağımlılık) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <!-- Toast JS — diğer tüm script'lerden ÖNCE (apiFetch/Toast bağımlılığı) -->
    <script src="~/js/toast.js"></script>
    <script src="~/js/app-nav.js"></script>

    <!-- Lightbox — output gallery etkileşimi (büyüt/indir/paylaş). Toast'tan sonra (Toast bağımlılığı). -->
    <script src="~/js/lightbox.js"></script>

    <!-- Çerez onay banner'ı -->
    <script src="~/js/cookie-banner.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
