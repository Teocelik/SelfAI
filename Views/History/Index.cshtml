@using System.Text.Json
@using SelfAI.Entities
@model SelfAI.ViewModels.HistoryViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = "Geçmiş - SelfAI";
}

@functions {
    // F.M.UI.3 — müzik üretimi: media item'larından biri "audio" etiketli.
    static bool IsMusic(Generation gen) =>
        gen.MediaItems.Any(m => string.Equals(m.MediaType, "audio", StringComparison.OrdinalIgnoreCase));

    static bool IsAudioUrl(string? url) =>
        !string.IsNullOrEmpty(url) && (
            url.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase) ||
            url.EndsWith(".m4a", StringComparison.OrdinalIgnoreCase) ||
            url.EndsWith(".wav", StringComparison.OrdinalIgnoreCase) ||
            url.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase) ||
            url.Contains("/music/", StringComparison.OrdinalIgnoreCase));

    // Müzik gen'inde audio = uzantısı ses olan (yoksa Order 0), kapak = ses olmayan (yoksa Order 1).
    static string? AudioUrl(Generation gen)
    {
        var ordered = gen.MediaItems.OrderBy(m => m.Order).ToList();
        return ordered.FirstOrDefault(m => IsAudioUrl(m.Url))?.Url
            ?? ordered.FirstOrDefault()?.Url;
    }

    static string? CoverUrl(Generation gen)
    {
        var ordered = gen.MediaItems.OrderBy(m => m.Order).ToList();
        return ordered.FirstOrDefault(m => !IsAudioUrl(m.Url))?.Url;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/history.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/history-music-player.css" asp-append-version="true" />
}

<div class="history-page">
    <div class="history-page__container">
        <header class="history-page__header">
            <h1 class="history-page__title">Geçmiş Üretimlerim</h1>
            <p class="history-page__subtitle">
                @if (Model.AllCount > 0)
                {
                    <span>Toplam @Model.AllCount üretim</span>
                }
                else
                {
                    <span>Henüz üretim yok</span>
                }
            </p>
        </header>

        <!-- Tab bar -->
        <nav class="history-tabs" aria-label="Üretim tipi filtresi">
            <a asp-controller="History" asp-action="Index" asp-route-type="all"
               class="history-tab @(Model.CurrentType == "all" ? "is-active" : "")">
                <span>Hepsi</span>
                <span class="history-tab__count">@Model.AllCount</span>
            </a>
            <a asp-controller="History" asp-action="Index" asp-route-type="image"
               class="history-tab @(Model.CurrentType == "image" ? "is-active" : "")">
                <i class="fas fa-image"></i>
                <span>Görseller</span>
                <span class="history-tab__count">@Model.ImageCount</span>
            </a>
            <a asp-controller="History" asp-action="Index" asp-route-type="music"
               class="history-tab @(Model.CurrentType == "music" ? "is-active" : "")">
                <i class="fas fa-music"></i>
                <span>Müzikler</span>
                <span class="history-tab__count">@Model.MusicCount</span>
            </a>
        </nav>

        @if (Model.Generations.Count == 0)
        {
            <div class="history-empty">
                <i class="fas fa-image history-empty__icon"></i>
                <h2 class="history-empty__title">
                    @(Model.CurrentType switch
                    {
                        "music" => "Henüz müzik üretmedin",
                        "image" => "Henüz görsel üretmedin",
                        _ => "Henüz üretim yok"
                    })
                </h2>
                <p class="history-empty__text">
                    Stüdyoya giderek ilk üretimini oluşturmaya başla.
                </p>
                <a asp-controller="StudioHub" asp-action="Index" class="history-empty__cta">
                    <i class="fas fa-wand-magic-sparkles"></i>
                    Stüdyoya Git
                </a>
            </div>
        }
        else
        {
            <div class="history-grid">
                @foreach (var gen in Model.Generations)
                {
                    if (IsMusic(gen))
                    {
                        var coverUrl = CoverUrl(gen);
                        var audioUrl = AudioUrl(gen) ?? "";
                        var promptFull = gen.PromptSnapshot ?? "Müzik üretimi";
                        var promptShort = promptFull.Length > 80
                            ? promptFull.Substring(0, 80) + "..."
                            : promptFull;

                        <article class="history-card history-card--music"
                                 data-history-music-card
                                 data-audio-url="@audioUrl"
                                 data-cover-url="@coverUrl"
                                 data-prompt="@promptFull"
                                 data-date="@gen.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")"
                                 tabindex="0"
                                 role="button"
                                 aria-label="Müziği çal">
                            <div class="history-card--music__cover">
                                @if (!string.IsNullOrEmpty(coverUrl))
                                {
                                    <img src="@coverUrl" alt="Albüm kapağı" loading="lazy" />
                                }
                                else
                                {
                                    <div class="history-card--music__cover-fallback">
                                        <i class="fas fa-music"></i>
                                    </div>
                                }
                                <div class="history-card--music__play-overlay">
                                    <i class="fas fa-play"></i>
                                </div>
                            </div>
                            <div class="history-card--music__body">
                                <span class="history-card--music__badge">
                                    <i class="fas fa-music"></i>
                                    <span>Müzik</span>
                                </span>
                                <p class="history-card--music__prompt">@promptShort</p>
                                <div class="history-card--music__meta">
                                    <span class="history-card--music__date">
                                        <i class="fas fa-clock"></i>
                                        @gen.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")
                                    </span>
                                    <span class="history-card--music__cost">
                                        <i class="fas fa-coins"></i>
                                        @gen.Cost
                                    </span>
                                </div>
                            </div>
                        </article>
                    }
                    else
                    {
                        var mediaUrls = gen.MediaItems.OrderBy(m => m.Order).Select(m => m.Url).ToList();
                        var firstUrl = mediaUrls.FirstOrDefault();
                        var statusClass = gen.Status switch
                        {
                            GenerationStatus.Completed => "history-card--completed",
                            GenerationStatus.Failed => "history-card--failed",
                            GenerationStatus.Refunded => "history-card--refunded",
                            _ => "history-card--pending"
                        };
                        var statusLabel = gen.Status switch
                        {
                            GenerationStatus.Completed => "Tamamlandı",
                            GenerationStatus.Failed => "Başarısız",
                            GenerationStatus.Refunded => "İade edildi",
                            _ => "Bekleniyor"
                        };

                        <article class="history-card @statusClass"
                                 data-history-card
                                 data-media-urls='@Html.Raw(JsonSerializer.Serialize(mediaUrls))'
                                 tabindex="0"
                                 role="button"
                                 aria-label="Üretim detayını görüntüle">

                            <div class="history-card__image">
                                @if (!string.IsNullOrEmpty(firstUrl))
                                {
                                    <img src="@firstUrl" alt="Üretim önizleme" loading="lazy" />
                                    @if (mediaUrls.Count > 1)
                                    {
                                        <div class="history-card__count">
                                            <i class="fas fa-images"></i>
                                            <span>+@(mediaUrls.Count - 1)</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="history-card__placeholder">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }

                                <div class="history-card__status">@statusLabel</div>
                            </div>

                            <div class="history-card__body">
                                @if (!string.IsNullOrEmpty(gen.PromptSnapshot))
                                {
                                    <p class="history-card__prompt">
                                        @(gen.PromptSnapshot.Length > 120
                                            ? gen.PromptSnapshot.Substring(0, 120) + "..."
                                            : gen.PromptSnapshot)
                                    </p>
                                }

                                <div class="history-card__meta">
                                    <span class="history-card__date">
                                        <i class="fas fa-clock"></i>
                                        @gen.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </span>
                                    <span class="history-card__cost">
                                        <i class="fas fa-coins"></i>
                                        @gen.Cost
                                    </span>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="history-pagination" aria-label="Sayfa navigasyonu">
                    @if (Model.HasPrevious)
                    {
                        <a asp-controller="History" asp-action="Index"
                           asp-route-type="@Model.CurrentType"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="history-pagination__btn"
                           aria-label="Önceki sayfa">
                            <i class="fas fa-chevron-left"></i>
                            <span>Önceki</span>
                        </a>
                    }

                    <div class="history-pagination__pages">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-controller="History" asp-action="Index"
                               asp-route-type="@Model.CurrentType"
                               asp-route-page="@i"
                               class="history-pagination__page @(i == Model.CurrentPage ? "history-pagination__page--active" : "")"
                               aria-label="Sayfa @i"
                               aria-current="@(i == Model.CurrentPage ? "page" : null)">
                                @i
                            </a>
                        }
                    </div>

                    @if (Model.HasNext)
                    {
                        <a asp-controller="History" asp-action="Index"
                           asp-route-type="@Model.CurrentType"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="history-pagination__btn"
                           aria-label="Sonraki sayfa">
                            <span>Sonraki</span>
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                </nav>
            }
        }
    </div>
</div>

<!-- Music Player Modal (Spotify tarzı) -->
<div id="musicPlayerModal" class="music-player-modal" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Müzik çalar">
    <div class="music-player-modal__backdrop" data-modal-close></div>
    <div class="music-player-modal__container">
        <button type="button" class="music-player-modal__close" data-modal-close aria-label="Kapat">
            <i class="fas fa-times"></i>
        </button>

        <div class="music-player-modal__body">
            <div class="music-player-modal__cover-wrap">
                <img id="playerCoverImage" src="" alt="Albüm kapağı" class="music-player-modal__cover" />
            </div>

            <div class="music-player-modal__info">
                <span class="music-player-modal__badge">
                    <i class="fas fa-music"></i>
                    <span>SelfAI Üretim</span>
                </span>
                <h2 class="music-player-modal__title" id="playerTitle"></h2>
                <p class="music-player-modal__date" id="playerDate"></p>

                <audio id="playerAudio" class="music-player-modal__audio" controls preload="metadata"></audio>

                <div class="music-player-modal__actions">
                    <a id="playerDownload" href="" download class="music-player-modal__action">
                        <i class="fas fa-download"></i>
                        <span>MP3 İndir</span>
                    </a>
                    <a id="playerCoverDownload" href="" download class="music-player-modal__action">
                        <i class="fas fa-image"></i>
                        <span>Kapak İndir</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/history-music-player.js" asp-append-version="true"></script>
}
