@model SelfAI.ViewModels.Admin.AdminUsersListViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Kullanıcılar";
}

<h1 class="admin-page-title">Kullanıcılar</h1>

<form asp-action="Users" method="get" class="admin-panel admin-filter-form">
    <div class="admin-filter-form__row">
        <div class="admin-filter-form__field">
            <input type="text"
                   name="searchTerm"
                   value="@Model.SearchTerm"
                   placeholder="Email veya isim ara..."
                   class="admin-form__input"
                   autocomplete="off" />
        </div>
        <div class="admin-filter-form__field admin-filter-form__field--select">
            <select name="dateFilter" class="admin-form__input">
                <option value="all" selected="@(Model.DateFilter == "all")">Tüm zamanlar</option>
                <option value="7d" selected="@(Model.DateFilter == "7d")">Son 7 gün</option>
                <option value="30d" selected="@(Model.DateFilter == "30d")">Son 30 gün</option>
            </select>
        </div>
        <button type="submit" class="admin-button admin-button--primary">Filtrele</button>
    </div>
</form>

@if (Model.UserList == null || !Model.UserList.Users.Any())
{
    <div class="admin-empty">
        <p>Kullanıcı bulunamadı.</p>
    </div>
}
else
{
    <div class="admin-user-table-wrap">
        <div class="admin-user-table-meta">
            Toplam @Model.UserList.TotalCount kullanıcı — Sayfa @Model.UserList.Page / @Model.UserList.TotalPages
        </div>

        <table class="admin-user-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>İsim</th>
                    <th class="admin-user-table__num">Bakiye</th>
                    <th class="admin-user-table__num">Üretim</th>
                    <th class="admin-user-table__num">Kullanılan</th>
                    <th>Kayıt</th>
                    <th>Rol</th>
                    <th>Aksiyon</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.UserList.Users)
                {
                    <tr>
                        <td class="admin-user-table__email">@user.Email</td>
                        <td>@(user.DisplayName ?? "-")</td>
                        <td class="admin-user-table__num">@user.CurrentBalance</td>
                        <td class="admin-user-table__num">@user.TotalGenerations</td>
                        <td class="admin-user-table__num">@user.TotalCreditsUsed</td>
                        <td class="admin-user-table__date">@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (user.IsAdmin)
                            {
                                <span class="admin-user-table__badge admin-user-table__badge--admin">Admin</span>
                            }
                        </td>
                        <td class="admin-user-table__actions">
                            <a href="@Url.Action("UserDetail", "Admin", new { userId = user.Id })"
                               class="admin-user-table__action">Detay</a>
                            <a href="@Url.Action("AddCredit", "Admin", new { userId = user.Id })"
                               class="admin-user-table__action admin-user-table__action--primary">Kredi Ekle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.UserList.TotalPages > 1)
        {
            <nav class="admin-pagination">
                @if (Model.UserList.HasPrevious)
                {
                    <a href="@Url.Action("Users", new { searchTerm = Model.SearchTerm, dateFilter = Model.DateFilter, page = Model.UserList.Page - 1 })"
                       class="admin-pagination__link">← Önceki</a>
                }
                else
                {
                    <span></span>
                }

                <span class="admin-pagination__info">
                    Sayfa @Model.UserList.Page / @Model.UserList.TotalPages
                </span>

                @if (Model.UserList.HasNext)
                {
                    <a href="@Url.Action("Users", new { searchTerm = Model.SearchTerm, dateFilter = Model.DateFilter, page = Model.UserList.Page + 1 })"
                       class="admin-pagination__link">Sonraki →</a>
                }
                else
                {
                    <span></span>
                }
            </nav>
        }
    </div>
}
