@model SelfAI.ViewModels.Music.MusicStudioIndexViewModel
@{
    Layout = "~/Views/Shared/_AppLayout.cshtml";
    ViewData["Title"] = "Müzik Üret - SelfAI";
}

@section Styles {
    <link rel="stylesheet" href="~/css/music-studio.css" asp-append-version="true" />
}

<section class="music-studio">
    <div class="music-studio__container">
        <a href="/Studio" class="music-studio__back">← Studio</a>

        <div class="music-studio__header">
            <h1 class="music-studio__title">Müzik Üret</h1>
            <p class="music-studio__subtitle">
                Video için backing track veya kendi şarkın — otomatik albüm kapağı ile.
            </p>
        </div>

        <div class="music-studio__mode-toggle">
            <button type="button" class="mode-toggle-option is-active" data-mode="backing">
                <div class="mode-toggle-option__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 18V5l12-2v13" />
                        <circle cx="6" cy="18" r="3" />
                    </svg>
                </div>
                <div class="mode-toggle-option__content">
                    <span class="mode-toggle-option__label">Backing Track</span>
                    <span class="mode-toggle-option__hint">Enstrümantal, 15-60 sn</span>
                </div>
            </button>
            <button type="button" class="mode-toggle-option" data-mode="song">
                <div class="mode-toggle-option__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                        <line x1="12" y1="19" x2="12" y2="23" />
                        <line x1="8" y1="23" x2="16" y2="23" />
                    </svg>
                </div>
                <div class="mode-toggle-option__content">
                    <span class="mode-toggle-option__label">Full Song</span>
                    <span class="mode-toggle-option__hint">Vokal + Lyrics, 60-180 sn</span>
                </div>
            </button>
        </div>

        <form class="music-studio__form" id="musicForm">

            <div class="music-form__field">
                <label for="musicPromptInput" class="music-form__label">
                    Müzik teması (prompt)
                </label>
                <textarea id="musicPromptInput"
                          class="music-form__textarea"
                          rows="3"
                          placeholder="Örn: upbeat electronic dance, tropical vibes, high energy"
                          maxlength="500"></textarea>
                <div class="music-form__hint">
                    <span id="promptCharCount">0</span> / 500
                </div>
            </div>

            <div class="music-form__field music-form__field--lyrics" id="lyricsField" hidden>
                <label for="lyricsInput" class="music-form__label">
                    Şarkı sözleri (opsiyonel)
                </label>
                <textarea id="lyricsInput"
                          class="music-form__textarea"
                          rows="5"
                          placeholder="Sözleri kendin yaz veya boş bırak — MiniMax otomatik oluşturur"
                          maxlength="2000"></textarea>
                <div class="music-form__hint">
                    <span id="lyricsCharCount">0</span> / 2000
                </div>
            </div>

            <div class="music-form__field">
                <label class="music-form__label">Süre</label>
                <div class="music-form__duration-options" id="durationOptions">
                    @* JS ile mode'a göre doldurulur *@
                </div>
                <div class="music-form__hint music-form__hint--left" id="durationNote" hidden>
                    Full Song'da süreyi model otomatik belirler; bu seçim yaklaşık hedeftir.
                </div>
            </div>

            <div class="music-form__field">
                <label class="music-form__label">Kapak formatı</label>
                <div class="music-form__cover-options">
                    @foreach (var opt in Model.CoverAspectRatios)
                    {
                        <button type="button"
                                class="cover-option @(opt.Value == "1:1" ? "is-selected" : "")"
                                data-aspect="@opt.Value">
                            <div class="cover-option__preview cover-option__preview--@opt.Icon"></div>
                            <span class="cover-option__label">@opt.Label</span>
                        </button>
                    }
                </div>
            </div>

            <div class="music-form__actions">
                <button type="button"
                        class="music-form__submit"
                        id="musicGenerateBtn"
                        disabled>
                    <span class="music-form__submit-label">Üret</span>
                    <span class="music-form__submit-spinner" hidden>
                        <svg viewBox="0 0 24 24" width="18" height="18">
                            <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-dasharray="30 30" stroke-linecap="round">
                                <animateTransform attributeName="transform" type="rotate"
                                                  from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite" />
                            </circle>
                        </svg>
                    </span>
                </button>
            </div>
        </form>

        <div class="music-results" id="musicResults" hidden>
            <div class="music-results__header">
                <h2 class="music-results__title">Sonuçlar</h2>
            </div>
            <div class="music-results__list" id="musicResultsList"></div>
        </div>
    </div>
</section>

<template id="musicResultTemplate">
    <div class="music-result-card">
        <div class="music-result-card__cover">
            <img class="music-result-card__cover-image" src="" alt="Albüm kapağı" hidden />
        </div>
        <div class="music-result-card__body">
            <div class="music-result-card__mode"></div>
            <div class="music-result-card__prompt"></div>
            <audio class="music-result-card__audio" controls></audio>
            <div class="music-result-card__actions">
                <a class="music-result-card__download" download target="_blank" rel="noopener">MP3 İndir</a>
                <a class="music-result-card__download-cover" download target="_blank" rel="noopener" hidden>Kapak İndir</a>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/music-studio.js" asp-append-version="true"></script>
}
