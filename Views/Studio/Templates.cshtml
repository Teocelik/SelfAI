@{
    ViewData["Title"] = "Sosyal Medya Postu — Yakında";
    Layout = "~/Views/Shared/_AppLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/studio-hub.css" asp-append-version="true" />
}

<section class="studio-coming-soon">
    <a href="/Studio" class="studio-coming-soon__back">← Studio</a>
    <div class="studio-coming-soon__content">
        <svg class="studio-coming-soon__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <line x1="3" y1="9" x2="21" y2="9" />
            <line x1="9" y1="21" x2="9" y2="9" />
        </svg>
        <h1 class="studio-coming-soon__title">Sosyal Medya Postu</h1>
        <p class="studio-coming-soon__description">
            Instagram post, Story, Reels cover, YouTube thumbnail, reklam
            görseli — her platform için doğru boyut ve hazır şablonlar.
            Prompt yaz, tek tuşla 4-5 farklı platform için üret.
        </p>
        <p class="studio-coming-soon__eta">Bu özellik yakında geliyor.</p>
    </div>
</section>
