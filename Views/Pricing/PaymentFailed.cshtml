@{
    ViewData["Title"] = "Ödeme Başarısız";
    Layout = "_Layout";
}

<div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="bg-[#1E1E1E] border border-red-500/50 rounded-2xl p-8 max-w-md text-center">
        <i class="fas fa-times-circle text-6xl text-red-500 mb-4"></i>
        <h1 class="text-2xl font-bold text-white mb-2">Ödeme Başarısız</h1>
        <p class="text-gray-300 mb-2">Ödeme tamamlanamadı.</p>
        @if (!string.IsNullOrEmpty(ViewBag.Reason as string))
        {
            <p class="text-gray-500 text-sm mb-6">Detay: @ViewBag.Reason</p>
        }
        <a asp-controller="Pricing" asp-action="Index"
           class="inline-block bg-white text-black px-6 py-3 rounded-lg font-semibold hover:bg-gray-200 transition-colors">
            Tekrar Dene
        </a>
    </div>
</div>
