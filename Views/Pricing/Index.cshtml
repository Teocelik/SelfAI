@model IReadOnlyList<SelfAI.Entities.Package>
@{
    ViewData["Title"] = "Paketler";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pricing.css" />
}

<div class="pricing-page">
    <div class="pricing-page__container">
        <header class="pricing-header">
            <h1 class="pricing-header__title">Paketler</h1>
            <p class="pricing-header__subtitle">İhtiyacına uygun planı seç</p>
        </header>

        <div class="pricing-grid">
            @foreach (var pkg in Model)
            {
                var isBestValue = pkg.Name == "Plus";
                var isFree = pkg.Name == "Free";
                var cardClass = isBestValue ? "pricing-card pricing-card--highlighted" : "pricing-card";

                <article class="@cardClass">
                    @if (isBestValue)
                    {
                        <div class="pricing-card__badge">En Popüler</div>
                    }

                    <header class="pricing-card__header">
                        <h2 class="pricing-card__name">@pkg.Name</h2>
                        <div class="pricing-card__price">
                            @if (isFree)
                            {
                                <span class="pricing-card__price-amount">₺0</span>
                                <span class="pricing-card__price-period">/ ücretsiz</span>
                            }
                            else
                            {
                                <span class="pricing-card__price-amount">₺@pkg.PriceTry?.ToString("0")</span>
                                <span class="pricing-card__price-period">/ ay</span>
                            }
                        </div>
                    </header>

                    <ul class="pricing-card__features">
                        <li class="pricing-feature">
                            <i class="fas fa-coins pricing-feature__icon"></i>
                            <span><strong>@pkg.MonthlyCredits</strong> credit / ay</span>
                        </li>

                        @if (isFree)
                        {
                            <li class="pricing-feature">
                                <i class="fas fa-gift pricing-feature__icon"></i>
                                <span>Kayıt bonusu (tek seferlik)</span>
                            </li>
                            <li class="pricing-feature pricing-feature--muted">
                                <i class="fas fa-times pricing-feature__icon--off"></i>
                                <span>Yenilenmez</span>
                            </li>
                        }
                        else
                        {
                            <li class="pricing-feature">
                                <i class="fas fa-check pricing-feature__icon"></i>
                                <span>Aylık yenilenen kredi</span>
                            </li>
                            <li class="pricing-feature">
                                <i class="fas fa-check pricing-feature__icon"></i>
                                <span>Tüm modeller</span>
                            </li>
                            <li class="pricing-feature">
                                <i class="fas fa-check pricing-feature__icon"></i>
                                <span>Character, Face Lock, Pose Lock</span>
                            </li>
                            @if (pkg.Name == "Plus" || pkg.Name == "Premium")
                            {
                                <li class="pricing-feature">
                                    <i class="fas fa-check pricing-feature__icon"></i>
                                    <span>Öncelikli generation</span>
                                </li>
                            }
                            @if (pkg.Name == "Premium")
                            {
                                <li class="pricing-feature">
                                    <i class="fas fa-check pricing-feature__icon"></i>
                                    <span>Ticari kullanım</span>
                                </li>
                            }
                        }
                    </ul>

                    @if (isFree)
                    {
                        <button type="button" disabled
                                class="pricing-card__cta pricing-card__cta--disabled">
                            Kayıt Bonusu
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="pricing-card__cta pricing-card__cta--primary subscribe-btn"
                                data-package-id="@pkg.Id"
                                data-package-name="@pkg.Name"
                                data-package-price="@pkg.PriceTry">
                            Abone Ol
                        </button>
                    }
                </article>
            }
        </div>

        <footer class="pricing-footer">
            <p>Tüm fiyatlar Türk Lirası (TRY) cinsindendir. KDV dahildir.</p>
        </footer>
    </div>
</div>

@section Scripts {
    <script src="~/js/pricing.js"></script>
}
