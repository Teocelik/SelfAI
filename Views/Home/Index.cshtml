@{
    ViewData["Title"] = "SelfAI - AI Görsel Stüdyosu";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" />
}

@* ═══════════════════════ NAV (sticky glass) ═══════════════════════ *@
<nav class="landing-nav">
    <div class="landing-nav__container">
        <a href="/" class="landing-nav__logo">SelfAI</a>

        <div class="landing-nav__links">
            <a asp-controller="Pricing" asp-action="Index" class="landing-nav__link">
                Paketler
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="RenderNet" asp-action="Index" class="landing-nav__cta">
                    Stüdyoya Dön
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="landing-nav__cta">
                    Giriş Yap
                </a>
            }
        </div>
    </div>
</nav>

@* ═══════════════════════ HERO ═══════════════════════ *@
<section class="landing-hero">
    <div class="landing-hero__container">
        <h1 class="landing-hero__headline">
            Vizyonunu Saniyeler İçinde Görsele Çevir.
        </h1>
        <p class="landing-hero__subline">
            AI ile profesyonel kalitede görseller. Karakter tutarlılığı,
            sahne kontrolü, sınırsız stil.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="RenderNet" asp-action="Index" class="landing-cta">
                Stüdyoya Dön
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="landing-cta">
                Hemen Başla
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
            <p class="landing-hero__trust">
                Ücretsiz hesabınla 5 credit kazanırsın
            </p>
        }
    </div>
</section>

@* ═══════════════════════ SHOWCASE ═══════════════════════ *@
<section class="landing-showcase">
    <div class="landing-showcase__grid">
        <div class="showcase-card showcase-card--portrait">
            <i class="fas fa-user-tie" aria-hidden="true"></i>
            <span>Portre</span>
        </div>
        <div class="showcase-card showcase-card--nature">
            <i class="fas fa-tree" aria-hidden="true"></i>
            <span>Doğa</span>
        </div>
        <div class="showcase-card showcase-card--product">
            <i class="fas fa-box-open" aria-hidden="true"></i>
            <span>Ürün</span>
        </div>
        <div class="showcase-card showcase-card--scene">
            <i class="fas fa-mountain" aria-hidden="true"></i>
            <span>Sahne</span>
        </div>
        <div class="showcase-card showcase-card--character">
            <i class="fas fa-mask" aria-hidden="true"></i>
            <span>Karakter</span>
        </div>
        <div class="showcase-card showcase-card--abstract">
            <i class="fas fa-palette" aria-hidden="true"></i>
            <span>Soyut</span>
        </div>
    </div>
</section>

@* ═══════════════════════ FEATURES ═══════════════════════ *@
<section class="landing-features">
    <h2 class="landing-features__title">Neler Yapabilirsin?</h2>
    <div class="landing-features__grid">
        <div class="feature-card">
            <i class="fas fa-user-friends" aria-hidden="true"></i>
            <h3>Karakter Tutarlılığı</h3>
            <p>Aynı karakteri farklı sahnelerde, farklı stillerde üret.</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-lock" aria-hidden="true"></i>
            <h3>Face &amp; Pose Lock</h3>
            <p>Yüz ifadesini ve pozisyonu referans görselden kilitle.</p>
        </div>
        <div class="feature-card">
            <i class="fas fa-layer-group" aria-hidden="true"></i>
            <h3>Multi-Model</h3>
            <p>Tek prompt'la birden fazla model ve stilde paralel üret.</p>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true"></script>
}
