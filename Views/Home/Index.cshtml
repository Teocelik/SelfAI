@{
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = "SelfAI — AI ile sosyal medya için hızlı içerik üretimi";
    ViewData["Description"] = "TikTok, Instagram, YouTube için AI-destekli görsel üretimi. Karakter tutarlılığı, yüz kopyalama ve 10+ AI model — dakikalar içinde.";
}

<section class="hero">
    <div class="hero__container">
        <div class="hero__content">
            <h1 class="hero__title">
                TikTok, Instagram, YouTube için
                <span class="hero__title-accent">içerik üretimini basitleştir</span>
            </h1>
            <p class="hero__subtitle">
                Karakter tutarlılığı, yüz kopyalama ve 10+ AI model ile sosyal
                medya görsellerini dakikalar içinde üret. Video ve otomatik
                gönderi — yakında.
            </p>
            <div class="hero__actions">
                <a href="@Url.Action("Login", "Account")" class="hero__cta hero__cta--primary">Ücretsiz Başla</a>
                <a href="#features" class="hero__cta hero__cta--secondary">Özellikleri Gör</a>
            </div>
            <div class="hero__meta">
                <span class="hero__meta-item">✓ Kredi kartı gerekmez</span>
                <span class="hero__meta-item">✓ Anında başla</span>
                <span class="hero__meta-item">✓ Türkçe destek</span>
            </div>
        </div>
        <div class="hero__showcase">
            <div class="hero__slider" id="heroSlider">
                <img src="~/img/landing/hero-1.jpg" alt="AI generated character" class="hero__slide hero__slide--active" />
                <img src="~/img/landing/hero-2.jpg" alt="Character in different scene" class="hero__slide" />
                <img src="~/img/landing/hero-3.jpg" alt="AI generated portrait" class="hero__slide" />
            </div>
            <div class="hero__slider-indicators" id="heroIndicators">
                <button class="hero__indicator hero__indicator--active" data-index="0" aria-label="Slide 1"></button>
                <button class="hero__indicator" data-index="1" aria-label="Slide 2"></button>
                <button class="hero__indicator" data-index="2" aria-label="Slide 3"></button>
            </div>
        </div>
    </div>
</section>

<section class="music-showcase" id="music-showcase">
    <div class="music-showcase__container">
        <div class="music-showcase__grid">

            <!-- Sol taraf: görsel + waveform + audio player -->
            <div class="music-showcase__visual">
                <div class="music-cover-card">
                    <div class="music-cover-card__cover">
                        <img src="~/img/landing/music-showcase-cover.jpg"
                             alt="SelfAI ile üretilmiş albüm kapağı örneği"
                             class="music-cover-card__image"
                             loading="lazy" />
                        <div class="music-cover-card__waveform">
                            <div class="waveform-bar" style="--i: 0"></div>
                            <div class="waveform-bar" style="--i: 1"></div>
                            <div class="waveform-bar" style="--i: 2"></div>
                            <div class="waveform-bar" style="--i: 3"></div>
                            <div class="waveform-bar" style="--i: 4"></div>
                            <div class="waveform-bar" style="--i: 5"></div>
                            <div class="waveform-bar" style="--i: 6"></div>
                            <div class="waveform-bar" style="--i: 7"></div>
                            <div class="waveform-bar" style="--i: 8"></div>
                            <div class="waveform-bar" style="--i: 9"></div>
                            <div class="waveform-bar" style="--i: 10"></div>
                            <div class="waveform-bar" style="--i: 11"></div>
                            <div class="waveform-bar" style="--i: 12"></div>
                            <div class="waveform-bar" style="--i: 13"></div>
                            <div class="waveform-bar" style="--i: 14"></div>
                            <div class="waveform-bar" style="--i: 15"></div>
                            <div class="waveform-bar" style="--i: 16"></div>
                            <div class="waveform-bar" style="--i: 17"></div>
                            <div class="waveform-bar" style="--i: 18"></div>
                            <div class="waveform-bar" style="--i: 19"></div>
                            <div class="waveform-bar" style="--i: 20"></div>
                            <div class="waveform-bar" style="--i: 21"></div>
                            <div class="waveform-bar" style="--i: 22"></div>
                            <div class="waveform-bar" style="--i: 23"></div>
                        </div>
                    </div>
                    <div class="music-cover-card__player">
                        <button type="button" class="music-cover-card__play" aria-label="Play">
                            <svg viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z" />
                            </svg>
                        </button>
                        <div class="music-cover-card__timeline">
                            <div class="music-cover-card__progress"></div>
                        </div>
                        <span class="music-cover-card__time">0:45</span>
                    </div>
                </div>
            </div>

            <!-- Sağ taraf: başlık + açıklama + feature list + CTA -->
            <div class="music-showcase__content">
                <span class="music-showcase__badge">Yeni Özellik</span>
                <h2 class="music-showcase__title">
                    AI ile Şarkını + Kapağını Üret
                </h2>
                <p class="music-showcase__description">
                    Reels için backing track ya da tam bir şarkı. SelfAI hem
                    müziği hem albüm kapağını otomatik üretir — Spotify,
                    TikTok, Instagram için hazır formatlar.
                </p>

                <ul class="music-showcase__features">
                    <li class="music-showcase__feature">
                        <svg class="music-showcase__feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span>Backing Track (15-60 saniye, enstrümantal)</span>
                    </li>
                    <li class="music-showcase__feature">
                        <svg class="music-showcase__feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span>Full Song (vokal + lyrics, 60-180 saniye)</span>
                    </li>
                    <li class="music-showcase__feature">
                        <svg class="music-showcase__feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span>Otomatik albüm kapağı (Spotify, Story, YouTube)</span>
                    </li>
                    <li class="music-showcase__feature">
                        <svg class="music-showcase__feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12" />
                        </svg>
                        <span>Ticari kullanıma uygun (Sonilo lisanslı)</span>
                    </li>
                </ul>

                <a href="@Url.Action("Login", "Account")" class="music-showcase__cta">
                    Denemek İçin Giriş Yap
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                        <polyline points="12 5 19 12 12 19" />
                    </svg>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="features" id="features">
    <div class="features__container">
        <div class="features__header">
            <h2 class="features__title">Bugün elimizde olanlar</h2>
            <p class="features__subtitle">
                Sosyal medyaya hazır görselleri üretmen için gereken temel araçlar
            </p>
        </div>
        <div class="features__grid">

            <article class="feature-card">
                <div class="feature-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <h3 class="feature-card__title">Karakterin, her sahnede</h3>
                <p class="feature-card__description">
                    Yüzünü veya karakterini eğit, sonra farklı prompt'larla
                    farklı sahnelerde tut. Instagram gönderisinden reklam
                    kampanyasına.
                </p>
                <div class="feature-card__visual">
                    <img src="~/img/landing/feature-character.jpg" alt="Karakter tutarlılığı örneği" loading="lazy" />
                </div>
            </article>

            <article class="feature-card">
                <div class="feature-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0-6 0"/>
                        <path d="M17.657 16.657 13.414 20.9a1.998 1.998 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"/>
                    </svg>
                </div>
                <h3 class="feature-card__title">Bir yüz, sonsuz sahne</h3>
                <p class="feature-card__description">
                    Tek fotoğraf yükle, o kişiyi istediğin kompozisyonda üret.
                    Eğitim yok, dakikalar içinde sonuç.
                </p>
                <div class="feature-card__visual">
                    <img src="~/img/landing/feature-face-lock.jpg" alt="Face Lock örneği" loading="lazy" />
                </div>
            </article>

            <article class="feature-card">
                <div class="feature-card__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                </div>
                <h3 class="feature-card__title">Her ihtiyaca özel model</h3>
                <p class="feature-card__description">
                    FLUX, Ideogram, Seedream, Recraft ve daha fazlası. Fotoğraf
                    gerçekçiliği mi, sanat mı, tipografi mi — sen seç.
                </p>
                <div class="feature-card__visual">
                    <img src="~/img/landing/feature-multi-model.jpg" alt="Multi-model örnekleri" loading="lazy" />
                </div>
            </article>

        </div>
    </div>
</section>

<section class="coming-soon">
    <div class="coming-soon__container">
        <div class="coming-soon__header">
            <span class="coming-soon__badge">Yakında</span>
            <h2 class="coming-soon__title">Ürün nereye gidiyor</h2>
            <p class="coming-soon__subtitle">
                Bugün görsel, yarın video, sonraki gün tam pipeline. Erken
                kullanıcıların önerileri ile yön veriyoruz.
            </p>
        </div>
        <div class="coming-soon__grid">
            <div class="coming-soon__item">
                <div class="coming-soon__icon">🎬</div>
                <h3 class="coming-soon__item-title">AI Video</h3>
                <p class="coming-soon__item-description">
                    Veo 3, Kling ile karakterin videoda konuşsun ve hareket etsin
                </p>
            </div>
            <div class="coming-soon__item">
                <div class="coming-soon__icon">📱</div>
                <h3 class="coming-soon__item-title">TikTok & Reels</h3>
                <p class="coming-soon__item-description">
                    9:16 format, hazır şablonlar, tek tıkla üret ve indir
                </p>
            </div>
            <div class="coming-soon__item">
                <div class="coming-soon__icon">🚀</div>
                <h3 class="coming-soon__item-title">Otomatik Gönderi</h3>
                <p class="coming-soon__item-description">
                    Ürettiğin içeriği doğrudan sosyal medya hesaplarına
                    zamanla ve gönder
                </p>
            </div>
        </div>
    </div>
</section>

<section class="cta-bottom">
    <div class="cta-bottom__container">
        <h2 class="cta-bottom__title">Denemeye hazır mısın?</h2>
        <p class="cta-bottom__subtitle">
            Kayıt ol, ilk kredilerin hazır. Kredi kartı istemiyoruz.
        </p>
        <a href="@Url.Action("Login", "Account")" class="cta-bottom__button">Ücretsiz Başla</a>
    </div>
</section>

<footer class="landing-footer">
    <div class="landing-footer__container">
        <div class="landing-footer__brand">
            <div class="landing-footer__logo">SelfAI</div>
            <p class="landing-footer__tagline">AI ile sosyal medya için hızlı içerik üretimi</p>
        </div>
        <div class="landing-footer__links">
            <div class="landing-footer__group">
                <h4 class="landing-footer__group-title">Ürün</h4>
                <a href="#features" class="landing-footer__link">Özellikler</a>
                <a href="@Url.Action("Login", "Account")" class="landing-footer__link">Giriş yap</a>
                <a href="@Url.Action("Login", "Account")" class="landing-footer__link">Kayıt ol</a>
            </div>
            <div class="landing-footer__group">
                <h4 class="landing-footer__group-title">Yasal</h4>
                <a href="/privacy" class="landing-footer__link">Gizlilik Politikası</a>
                <a href="/terms" class="landing-footer__link">Kullanım Şartları</a>
                <a href="/kvkk" class="landing-footer__link">KVKK Aydınlatma</a>
                <a href="/cookies" class="landing-footer__link">Çerez Politikası</a>
                <a href="/faq" class="landing-footer__link">SSS</a>
            </div>
            <div class="landing-footer__group">
                <h4 class="landing-footer__group-title">İletişim</h4>
                <a href="mailto:destek@selfai.com" class="landing-footer__link">destek@selfai.com</a>
            </div>
        </div>
    </div>
    <div class="landing-footer__bottom">
        <span>&copy; @DateTime.UtcNow.Year SelfAI. Tüm hakları saklıdır.</span>
    </div>
</footer>
