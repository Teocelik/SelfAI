<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ac0730ff-7bac-4e10-a47e-3c71bdb5a5f5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.400.*" />
    <PackageReference Include="FirebaseAdmin" Version="3.5.0" />
    <PackageReference Include="FirebaseAuthentication.net" Version="4.1.0" />
    <PackageReference Include="Iyzipay" Version="2.1.67" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.6" />
    <!-- F.M.10b — server-side text overlay (Apache 2.0). ImageSharp.Drawing beta15 = 2.1.x uyumlu son sürüm; v3+ ticari lisans.
         DİKKAT: Fonts SABİT 1.0.0-beta18'e pinli — Drawing beta15 bu sürüme karşı derlendi.
         Fonts 1.0.x (1.0.1) IGlyphRenderer.BeginGlyph imzasını değiştirdi → DrawText runtime'da
         TypeLoadException fırlatıyor. Fonts'u yükseltme (bkz. BUGFIX HISTORY). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.*" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="1.0.0-beta15" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.0-beta18" />
    <PackageReference Include="Stripe.net" Version="48.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- F.8 — Content moderation blacklist. Kökteki Data/ klasöründe (SelfAI.Data namespace'iyle
         aynı fiziksel klasör). ContentModerationService startup'ta ContentRootPath/Data'dan okur.
         Web SDK **/*.json'u zaten Content olarak globlar; Update ile output + publish kopyalanmasını
         garanti ederiz (Include duplicate hatası vermesin diye Update kullanılır). -->
    <Content Update="Data\moderation-blacklist.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DTOs\RenderNetGenerationDto\" />
    <Folder Include="Views\Account\" />
    <Folder Include="wwwroot\images\models\flux\" />
  </ItemGroup>

</Project>
